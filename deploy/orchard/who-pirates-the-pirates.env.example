# The machine runs on a private Apple container network. If you expose the
# machine beyond your Mac, use a private overlay and TLS instead.
APP_DB_PATH=/var/lib/who-pirates-the-pirates/catalog.sqlite
APP_STATE_PATH=/var/lib/who-pirates-the-pirates/app_state.sqlite
APP_BIND_ADDR=0.0.0.0
APP_ALLOW_INSECURE_HTTP=true
PORT=8080
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
