# Copy to /etc/who-pirates-the-pirates.env and set mode 0600.
# Keep this file readable only by root and the service administrator.

APP_DB_PATH=/var/lib/who-pirates-the-pirates/catalog.sqlite
APP_STATE_PATH=/var/lib/who-pirates-the-pirates/app_state.sqlite
APP_BIND_ADDR=127.0.0.1
PORT=8080
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# If a TLS reverse proxy terminates HTTPS, keep the app on loopback and set:
# APP_COOKIE_SECURE=true
